                "type": "text/javascript",
                "packages": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut 204 No Content\", () => pm.response.to.have.status(204));\r",
                  "pm.test(\"Corps de réponse vide\", () => pm.expect(pm.response.text()).to.be.empty);"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
